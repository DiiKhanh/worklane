# Copy to .env and adjust. The compose stack has sane local defaults baked in; these
# matter mainly for running binaries directly or for production.

# --- otp-api / otp-dispatcher ---
MYSQL_DSN=root:secret@tcp(localhost:3306)/otp?parseTime=true&multiStatements=true
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
HTTP_ADDR=:8888

# OTP policy
OTP_CODE_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=3
OTP_LIMIT_RECIPIENT=5
OTP_LIMIT_TENANT=100
OTP_RESEND_COOLDOWN=1m

# --- email provider selection ---
# smtp -> MailHog (local/e2e); resend -> Resend (production)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# Production email (Resend) - only used when EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=OTP <otp@worklane.dev>
RESEND_BASE_URL=https://api.resend.com

# --- SMS provider (Twilio, dispatcher) ---
# Use test credentials for local/dev. +15005550006 is Twilio's magic "valid" number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_BASE_URL=https://api.twilio.com
OTP_SMS_BODY_FMT=Your verification code is %s. It expires in 5 minutes.
