  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Traefik routes synchronous HTTP requests to otp-api",
        "Redpanda/Kafka decouples the API from OTP delivery",
        "otp-dispatcher selects email or SMS from the requested channel"
      ]
    },
    {
      "dot": "rose",
      "title": "Identity and security",
      "items": [
        "auth-svc issues EdDSA JWTs for dashboard sessions",
        "otp-api verifies JWTs locally and introspects API keys over internal HTTP",
        "Plaintext OTP codes are never stored in MySQL"
      ]
    },
    {
      "dot": "amber",
      "title": "Known unknowns",
      "items": [
        "The dashboard hosting provider and network boundary are not confirmed",
        "No cloud provider or multi-region topology is inferred"
      ]
    }
